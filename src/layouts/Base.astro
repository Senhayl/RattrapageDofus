---
import "../styles/global.css";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { homeUrl, getClasses, classUrl, DEFAULT_START } from "../lib/data";
import { categoryUrl, updatesUrl, privacyUrl } from "../lib/content";
import { UI, CATEGORIES, type Lang } from "../i18n/ui";
import { CT } from "../i18n/content";
import { SITE } from "../config";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** La même page dans chaque langue. */
  alternates: { lang: Lang; href: string }[];
  /** Données structurées supplémentaires (schema.org). */
  jsonLd?: object[];
  /** Image de partage (chemin depuis la racine du site). */
  ogImage?: string;
  /** Rubrique active dans le menu. */
  section?: string;
  noindex?: boolean;
  /** Hero illustré sous l'en-tête : « home » (plein écran) ou « band » (bandeau de page de classe). */
  hero?: "home" | "band";
}
const { lang, title, description, alternates, jsonLd = [], ogImage, section, noindex = false, hero } = Astro.props;
const t = UI[lang];
const c = CT[lang];
const site = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, site).href;
const fr = alternates.find((a) => a.lang === "fr");
const image = abs(ogImage ?? `/og/${lang}/home.png`);
const footerNav = [
  ...CATEGORIES.map((k) => ({ name: c.cats[k].name, href: categoryUrl(lang, k, DEFAULT_START) })),
  { name: c.nav.updates, href: updatesUrl(lang) },
  { name: c.privacy, href: privacyUrl(lang) },
];
// Illustration du hero : déposer public/hero.webp (≥ 2560×1600) pour l'activer.
const heroImg = existsSync(join(process.cwd(), "public", "hero.webp")) ? "/hero.webp" : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(Astro.url.pathname)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    {fr && <link rel="alternate" hreflang="x-default" href={abs(fr.href)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0d14" />
    {hero && heroImg && <link rel="preload" as="image" href={heroImg} fetchpriority="high" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(Astro.url.pathname)} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={{ fr: "fr_FR", en: "en_US", es: "es_ES" }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    {
      hero ? (
        <div class:list={["hero", hero]}>
          {heroImg && <img class="hero-img" src={heroImg} alt="" decoding="async" fetchpriority="high" />}
          <div class="scrim" aria-hidden="true" />
          <SiteHeader lang={lang} alternates={alternates} section={section} />
          <div class="hero-content">
            <slot name="hero" />
          </div>
        </div>
      ) : (
        <SiteHeader lang={lang} alternates={alternates} section={section} />
      )
    }

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {
          SITE.supportUrl && (
            <p class="support">
              {c.supportPitch}{" "}
              <a href={SITE.supportUrl} rel="noopener" target="_blank">
                {c.support}
              </a>
            </p>
          )
        }
        <div class="links">
          <nav aria-label={c.nav.classes}>
            <p class="ft">{c.nav.classes}</p>
            <ul>
              {
                getClasses(lang).map((cl) => (
                  <li>
                    <a href={classUrl(lang, cl.id, DEFAULT_START)}>{cl.nom}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <nav aria-label={c.nav.label}>
            <p class="ft">{c.nav.label}</p>
            <ul>
              {
                footerNav.map((n) => (
                  <li>
                    <a href={n.href}>{n.name}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <p class="disclaimer">{t.footer}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .hero {
    position: relative;
    background: var(--bg-hero);
    isolation: isolate;
  }
  .hero.home {
    min-height: min(800px, 100svh);
  }
  .hero.band {
    min-height: 420px;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .home .scrim {
    background: linear-gradient(180deg, rgba(6, 7, 12, 0.55) 0%, rgba(6, 7, 12, 0) 20%, rgba(6, 7, 12, 0) 62%, #0b0d14 100%);
  }
  .band .scrim {
    background: linear-gradient(180deg, rgba(6, 7, 12, 0.55) 0%, rgba(6, 7, 12, 0) 35%, #0b0d14 100%);
  }
  main {
    min-height: 50vh;
  }
  .site-footer {
    margin-top: 110px;
    border-top: 1px solid var(--line-soft);
    padding: 30px 0 48px;
    color: var(--faint);
    font-size: 0.82rem; /* 14px */
  }
  .support {
    margin: 0 0 28px;
    max-width: 68ch;
    font-size: 0.94rem;
    color: var(--text-3);
    font-weight: 300;
  }
  .support a {
    color: var(--accent);
    font-weight: 500;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .support a:hover {
    color: #fff;
  }
  .links {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px 48px;
    margin-bottom: 28px;
  }
  @media (max-width: 640px) {
    .links {
      grid-template-columns: 1fr;
    }
  }
  .ft {
    margin: 0 0 8px;
    font-weight: 500;
    color: var(--muted);
  }
  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 9rem;
    column-gap: 24px;
  }
  .links nav:last-child ul {
    columns: 1;
  }
  .links li {
    padding: 2px 0;
  }
  .links a {
    color: var(--faint);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--text);
  }
  .disclaimer {
    max-width: 68ch;
    margin: 0;
  }
</style>
