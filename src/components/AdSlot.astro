---
// Emplacement publicitaire. « sidebar » : colonne latérale sur grand écran ;
// « inline » : bloc dans le contenu, visible partout. Rien n'est affiché en production
// tant qu'AdSense n'est pas configuré dans src/config.ts.
import { UI, type Lang } from "../i18n/ui";
import { SITE } from "../config";

interface Props {
  lang: Lang;
  kind?: "sidebar" | "inline";
}
const { lang, kind = "sidebar" } = Astro.props;
const t = UI[lang];
const client = SITE.adsense.client;
const slot = SITE.adsense.slots[kind];
const dev = import.meta.env.DEV;
---

{
  client && slot ? (
    <aside class:list={["ad", kind]} aria-label={t.adLabel}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format={kind === "inline" ? "auto" : "vertical"}
        data-full-width-responsive="true"
      />
      <script is:inline>{`(window.adsbygoogle = window.adsbygoogle || []).push({});`}</script>
    </aside>
  ) : dev ? (
    <aside class:list={["ad", kind, "placeholder"]} aria-hidden="true">
      {t.adDev}
    </aside>
  ) : null
}

<style>
  .ad.sidebar {
    position: sticky;
    top: 24px;
    width: 300px;
    min-height: 600px;
  }
  .ad.inline {
    margin: 32px 0;
    min-height: 100px;
  }
  .placeholder {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-l);
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
