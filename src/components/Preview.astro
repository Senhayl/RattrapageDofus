---
// Aperçu à côté de la phrase de l'accueil : ce que la page de classe va montrer.
// Rendu côté serveur pour la sélection par défaut, puis mis à jour en JS.
import { getClasses, getClassDiff, versions, versionLabel, classUrl, countChanges, highlightsOf, balanceOf, DEFAULT_START } from "../lib/data";
import { UI, type Lang } from "../i18n/ui";
import BalanceBar from "./BalanceBar.astro";

interface Props {
  lang: Lang;
  classId?: number;
}
const { lang, classId = 8 } = Astro.props;
const t = UI[lang];
const cls = getClasses(lang).find((c) => c.id === classId)!;
const start = versions.depart.find((v) => v.version === DEFAULT_START)!;
const d = getClassDiff(lang, DEFAULT_START, classId);
const lines = highlightsOf(lang, d, 4);
const n = countChanges(d);
const labels = Object.fromEntries(versions.depart.map((v) => [v.version, v.version]));
const names = Object.fromEntries(getClasses(lang).map((c) => [c.slug, c.nom]));
const VERDICT = { up: t.up, nerf: t.nerf };
---

<aside
  class="preview"
  aria-live="polite"
  data-lang={lang}
  data-current={`${cls.slug}|${DEFAULT_START}`}
  data-labels={JSON.stringify(labels)}
  data-names={JSON.stringify(names)}
  data-strings={JSON.stringify({ title: t.previewTitle("{c}", "{v}"), more: t.previewMore(999), empty: t.previewEmpty, up: t.up, nerf: t.nerf, becomes: t.becomes })}
>
  <div class="p-head">
    <p class="p-title">{t.previewTitle(cls.nom, start.version)}</p>
    <a class="p-more" href={classUrl(lang, classId, DEFAULT_START)}>{t.previewMore(n)}</a>
  </div>
  <BalanceBar lang={lang} balance={balanceOf(d)} compact />
  <ul class="p-lines">
    {
      lines.map((l) => (
        <li data-el={l.element ?? undefined}>
          <span class="p-spell">
            {l.sort}
            {l.verdict && <span class:list={["vtag", l.verdict]}>{VERDICT[l.verdict]}</span>}
          </span>
          <span class="p-label">{l.label}</span>
          <span class="p-value">
            <del>{l.avant}</del>
            <span class="p-arrow" aria-label={t.becomes}>→</span>
            <span class="p-after">{l.apres}</span>
          </span>
        </li>
      ))
    }
  </ul>
  {lines.length === 0 && <p class="p-empty">{t.previewEmpty}</p>}
</aside>

<script>
  type Line = { sort: string; label: string; avant: string; apres: string; verdict: "up" | "nerf" | null; element?: string | null };
  type Entry = { n: number; url: string; lines: Line[]; balance: Record<string, number> };
  const el = document.querySelector<HTMLElement>(".preview");
  if (el) {
    const lang = el.dataset.lang!;
    const labels = JSON.parse(el.dataset.labels!);
    const names = JSON.parse(el.dataset.names!);
    const s = JSON.parse(el.dataset.strings!);
    let data: Record<string, Record<string, Entry>> | null = null;
    let pending: Promise<unknown> | null = null;
    const load = () =>
      fetch(`/apercu/${lang}.json`)
        .then((r) => r.json())
        .then((j) => (data = j));
    const esc = (x: string) => x.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);

    const render = (classe: string, depuis: string) => {
      const e = data?.[classe]?.[depuis];
      if (!e) return;
      el.querySelector(".p-title")!.textContent = s.title.replace("{c}", names[classe]).replace("{v}", labels[depuis]);
      const bar = el.querySelector<HTMLElement>(".balance");
      if (bar) {
        const total = Object.values(e.balance).reduce((a, b) => a + b, 0) || 1;
        for (const k of ["up", "nerf", "mixte", "neutre"]) {
          const seg = bar.querySelector<HTMLElement>(`[data-k="${k}"]`);
          if (seg) seg.style.flexGrow = String(e.balance[k] / total);
          const num = bar.querySelector<HTMLElement>(`[data-n="${k}"]`);
          if (num) num.textContent = String(e.balance[k]);
        }
      }
      el.querySelector(".p-lines")!.innerHTML = e.lines
        .map(
          (l) => `<li${l.element ? ` data-el="${l.element}"` : ""}><span class="p-spell">${esc(l.sort)}` +
            (l.verdict ? `<span class="vtag ${l.verdict}">${esc(s[l.verdict])}</span>` : "") +
            `</span><span class="p-label">${esc(l.label)}</span><span class="p-value"><del>${esc(l.avant)}</del>` +
            `<span class="p-arrow" aria-label="${esc(s.becomes)}">→</span><span class="p-after">${esc(l.apres)}</span>` +
            `</span></li>`
        )
        .join("");
      let empty = el.querySelector<HTMLElement>(".p-empty");
      if (!e.lines.length && !empty) {
        empty = document.createElement("p");
        empty.className = "p-empty";
        empty.textContent = s.empty;
        el.querySelector(".p-lines")!.after(empty);
      }
      if (e.lines.length && empty) empty.remove();
      const more = el.querySelector<HTMLAnchorElement>(".p-more")!;
      more.href = e.url;
      more.textContent = s.more.replace("999", String(e.n));
    };

    // la sélection affichée (au départ, celle rendue côté serveur)
    let current = el.dataset.current;
    document.addEventListener("picker:change", (ev) => {
      const { classe, depuis } = (ev as CustomEvent).detail;
      if (`${classe}|${depuis}` === current) return;
      current = `${classe}|${depuis}`;
      pending ??= load();
      pending.then(() => render(classe, depuis));
    });
  }
</script>

<style is:global>
  .preview {
    max-width: 820px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px 30px 22px;
    text-align: left;
  }
  .preview .p-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 16px;
  }
  .preview .p-title {
    margin: 0;
    font-weight: 500;
    font-size: 1.18rem; /* 20px */
  }
  .preview .p-more {
    color: var(--accent);
    font-size: 0.88rem;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .preview .p-more:hover {
    color: #fff;
  }
  .preview .p-lines {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
  }
  @media (max-width: 640px) {
    .preview {
      padding: 22px 20px 18px;
    }
    .preview .p-lines {
      grid-template-columns: 1fr;
    }
  }
  .preview .p-lines li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .preview .p-spell {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    font-weight: 500;
    font-size: 0.94rem; /* 16px */
  }
  .preview .p-label {
    color: var(--muted);
    font-size: 0.8rem; /* 13.5px */
  }
  .preview .p-lines li[data-el] .p-label::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: 0.1em;
    background: var(--el-color);
  }
  .preview .p-value {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.91rem; /* 15.5px */
  }
  .preview .p-arrow {
    color: var(--faint);
  }
  .preview .p-after {
    color: #fff;
  }
  .preview .p-empty {
    color: var(--muted);
    margin: 12px 0 0;
  }
</style>
