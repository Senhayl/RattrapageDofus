---
import { changeGroup, changeLabel, formatValue, spellVerdict, deltaOf, type ModifiedSpell } from "../lib/data";
import { UI, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  spell: ModifiedSpell;
}
const { lang, spell } = Astro.props;
const t = UI[lang];
const verdict = spellVerdict(spell);
const renamed = spell.changements.find((c) => c.cle === "name");
const rows = spell.changements.filter((c) => c.cle !== "name");

// « Flèche Glacée : +8 dégâts de base » -> « +8 dégâts de base » quand le sort parle de lui-même
const escaped = spell.nom.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const selfPrefix = new RegExp(`^${escaped}\\s?:\\s`);
const show = (v: string | null) => (v === null ? null : v.replace(selfPrefix, ""));
const VERDICT_TEXT = { up: t.up, nerf: t.nerf, mixte: t.mixed };
---

<article class="spell" id={`sort-${spell.spellId}`} data-verdict={verdict ?? "neutre"}>
  <header>
    <h3>{spell.nom}</h3>
    {verdict && <span class:list={["vtag", verdict]}>{VERDICT_TEXT[verdict]}</span>}
    {renamed && <span class="was">{t.wasNamed(String(renamed.avant))}</span>}
  </header>
  <ul>
    {
      rows.map((c) => {
        const before = show(formatValue(lang, c, c.avant));
        const after = show(formatValue(lang, c, c.apres));
        return (
          <li class="row" data-group={changeGroup(c)} data-el={c.element ?? undefined}>
            <span class="label">{changeLabel(lang, c)}</span>
            <span class="value">
              {c.cle === "castFlags" ? (
                <span class="after">{t.castFlags}</span>
              ) : c.cle === "description" ? (
                <>
                  <span class="desc-old">
                    {t.before} : {before}
                  </span>
                  <span class="desc-new">
                    {t.now} : {after}
                  </span>
                </>
              ) : before === null ? (
                <span class="after">{after}</span>
              ) : after === null ? (
                <del>{before}</del>
              ) : (
                <>
                  <del>{before}</del>
                  <span class="arrow" aria-label={t.becomes}>
                    →
                  </span>
                  <span class="after">{after}</span>
                  {deltaOf(c) && <span class="delta">({deltaOf(c)})</span>}
                </>
              )}
              {c.verdict && <span class:list={["vtag", "mini", c.verdict]}>{VERDICT_TEXT[c.verdict]}</span>}
            </span>
          </li>
        );
      })
    }
  </ul>
</article>

<style>
  .spell {
    padding: 24px 0 22px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .spell:target h3 {
    color: var(--accent);
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  h3 {
    font-size: 1.3rem; /* 22px */
  }
  .was {
    color: var(--muted);
    font-size: 0.88rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .row {
    display: grid;
    grid-template-columns: 11.5rem 1fr;
    gap: 4px 16px;
    align-items: baseline;
  }
  .label {
    color: var(--muted);
    font-size: 0.88rem; /* 15px */
  }
  .row[data-el] .label::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 7px;
    background: var(--el-color);
    vertical-align: 0.15em;
  }
  .value {
    max-width: 68ch;
  }
  .arrow {
    color: var(--faint);
    margin: 0 0.35em;
  }
  .after {
    color: #fff;
  }
  .delta {
    color: var(--faint);
    margin-left: 0.35em;
    font-variant-numeric: tabular-nums;
  }
  .mini {
    margin-left: 0.6em;
  }
  .desc-old,
  .desc-new {
    display: block;
    font-size: 0.94rem;
    white-space: pre-line;
    font-weight: 300;
  }
  .desc-old {
    color: var(--faint);
    margin-bottom: 4px;
  }
  .desc-new {
    color: var(--text-3);
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
