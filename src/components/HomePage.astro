---
import Base from "../layouts/Base.astro";
import Picker from "./Picker.astro";
import Preview from "./Preview.astro";
import {
  getClasses,
  getClassDiff,
  countChanges,
  balanceOf,
  versions,
  versionLabel,
  DEFAULT_START,
  classUrl,
  homeUrl,
  alternates,
} from "../lib/data";
import { UI, CATEGORIES, type Lang } from "../i18n/ui";
import { CT } from "../i18n/content";
import { getContent, rowsFor, countsOf, categoryUrl, patches, patchUrl, updatesUrl, versionDate } from "../lib/content";
import { SITE } from "../config";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const start = versions.depart.find((v) => v.version === DEFAULT_START)!;
const rows = getClasses(lang).map((c) => {
  const d = getClassDiff(lang, DEFAULT_START, c.id);
  return { ...c, n: countChanges(d), b: balanceOf(d), added: d.sorts_ajoutes.length };
});
const max = Math.max(...rows.map((r) => r.n));
const ct = CT[lang];
const content = getContent(lang, DEFAULT_START);
const cats = CATEGORIES.map((k) => ({ k, ...countsOf(rowsFor(lang, k, content)) }));
const recent = patches.slice(0, 3);
const site = Astro.site ?? Astro.url;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: new URL(homeUrl(lang), site).href,
    inLanguage: lang,
    description: t.homeDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: ct.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base
  lang={lang}
  title={t.homeTitle}
  description={t.homeDescription}
  alternates={alternates(homeUrl)}
  section="classes"
  jsonLd={jsonLd}
  hero="home"
>
  <section class="hero-inner" slot="hero">
    <p class="kicker">{t.heroKicker(rows.length, versions.depart.length + 1)}</p>
    <Picker lang={lang}>
      <p class="lede">{t.lede}</p>
    </Picker>
  </section>

  <div class="wrap preview-wrap">
    <Preview lang={lang} />
  </div>

  <section class="wrap classes" aria-labelledby="classes-title">
    <div class="classes-head">
      <h2 id="classes-title">{t.perClassTitle} <em>{t.sinceV(start.version)}</em></h2>
      <p class="legend" aria-hidden="true">
        <span class="lg up">{t.balance.up}</span>
        <span class="lg nerf">{t.balance.nerf}</span>
        <span class="lg mixte">{t.balance.mixte}</span>
        <span class="lg neutre">{t.balance.neutre}</span>
      </p>
    </div>
    <ul>
      {
        rows.map((r) => (
          <li>
            <a
              href={classUrl(lang, r.id, DEFAULT_START)}
              aria-label={`${r.nom} : ${r.n} — ${r.b.up} ${t.balance.up}, ${r.b.nerf} ${t.balance.nerf}`}
            >
              <span class="name">{r.nom}</span>
              <span class="count">{r.n}</span>
              <span class="bar" style={`width:${Math.max(4, (r.n / max) * 100)}%`} aria-hidden="true">
                <span class="up" style={`flex-grow:${r.b.up}`} />
                <span class="nerf" style={`flex-grow:${r.b.nerf}`} />
                <span class="mixte" style={`flex-grow:${r.b.mixte}`} />
                <span class="neutre" style={`flex-grow:${r.b.neutre + r.added}`} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap rest" aria-labelledby="rest-title">
    <h2 id="rest-title">{ct.homeCats(versionLabel(lang, start))}</h2>
    <ul class="cats">
      {
        cats.map((c) => (
          <li>
            <a href={categoryUrl(lang, c.k, DEFAULT_START)}>
              <span class="cn">{ct.cats[c.k].name}</span>
              <span class="cc">{ct.counts(c.m, c.a, c.r)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap rest" aria-labelledby="upd-title">
    <h2 id="upd-title">{ct.homeUpdates}</h2>
    <ul class="cats">
      {
        recent.map((p) => (
          <li>
            <a href={patchUrl(lang, p.version)}>
              <span class="cn">Dofus {p.version}</span>
              <span class="cc">{versionDate(lang, p.version)}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={updatesUrl(lang)}>
          <span class="cn">{ct.nav.updates}</span>
          <span class="cc">{ct.seeAll}</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{ct.faqTitle}</h2>
    {
      ct.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>
</Base>

<style>
  .hero-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(96px, 16vh, 170px) var(--gutter) 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }
  .kicker {
    margin: 0;
    font-size: 0.82rem; /* 14px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .lede {
    margin: 0;
    font-weight: 300;
    font-size: 1.12rem; /* 19px */
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .preview-wrap {
    margin-top: -110px;
    position: relative;
  }

  .classes {
    padding-top: 96px;
  }
  .classes-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 18px;
  }
  h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.125rem); /* 34px */
  }
  h2 em {
    color: var(--accent);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .lg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lg::before {
    content: "";
    width: 12px;
    height: 3px;
    background: var(--c);
  }
  .classes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    column-gap: 36px;
  }
  .classes a {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 10px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .classes a:hover,
  .classes a:focus-visible {
    border-top-color: var(--accent);
  }
  .name {
    font-size: 1.12rem; /* 19px */
    color: var(--text);
  }
  .count {
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    grid-column: 1 / -1;
    display: flex;
    gap: 2px;
    height: 3px;
    overflow: hidden;
  }
  .bar > span {
    flex-basis: 0;
    min-width: 0;
    background: var(--c);
  }
  .up,
  .lg.up {
    --c: var(--up);
  }
  .nerf,
  .lg.nerf {
    --c: var(--nerf);
  }
  .mixte,
  .lg.mixte {
    --c: var(--mixte);
  }
  .neutre,
  .lg.neutre {
    --c: var(--neutre);
  }

  .rest,
  .faq {
    margin-top: 88px;
  }
  .rest h2,
  .faq h2 {
    margin-bottom: 18px;
  }
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    column-gap: 36px;
  }
  .cats a {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .cats a:hover {
    border-top-color: var(--accent);
  }
  .cn {
    font-size: 1.12rem;
    color: var(--text);
  }
  .cc {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .faq details {
    border-top: 1px solid var(--line);
    max-width: 72ch;
  }
  .faq details:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    padding: 16px 0;
    font-weight: 500;
    cursor: pointer;
  }
  .faq summary:hover {
    color: #fff;
  }
  .faq p {
    margin: 0 0 18px;
    color: var(--text-3);
    font-weight: 300;
  }
</style>
