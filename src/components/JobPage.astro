---
// Recettes d'un métier modifiées depuis une version de départ.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import VersionSelect from "./VersionSelect.astro";
import ChangeTable from "./ChangeTable.astro";
import { versions, versionLabel, alternates, DEFAULT_START } from "../lib/data";
import { getContent, recipeRows, countsOf, categoryUrl, jobsOf, jobUrl } from "../lib/content";
import { CT } from "../i18n/content";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  jobId: number;
  depuis: string;
}
const { lang, jobId, depuis } = Astro.props;
const t = CT[lang];
const job = jobsOf(lang).find((j) => j.id === jobId)!;
const now = versions.actuelle.version;
const start = versions.depart.find((v) => v.version === depuis)!;
const rows = recipeRows(lang, getContent(lang, depuis), jobId);
const { m, a, r } = countsOf(rows);
const others = versions.depart.filter((v) => v.version !== depuis);
---

<Base
  lang={lang}
  title={t.jobTitle(job.nom, depuis, now)}
  description={t.jobDescription(job.nom, depuis, now, m, a, r)}
  alternates={alternates((l) => jobUrl(l, jobId, depuis))}
  section="metiers"
>
  <div class="wrap">
    <Breadcrumbs
      lang={lang}
      items={[
        { name: t.cats.metiers.name, href: categoryUrl(lang, "metiers", DEFAULT_START) },
        { name: job.nom, href: jobUrl(lang, jobId, DEFAULT_START) },
        { name: versionLabel(lang, start) },
      ]}
    />
    <section class="intro">
      <h1>{t.jobH1(job.nom, depuis)}</h1>
      <VersionSelect lang={lang} depuis={depuis} urlFor={(v) => jobUrl(lang, jobId, v)} />
      <p class="counts">{t.counts(m, a, r)}</p>
    </section>
    <ChangeTable lang={lang} rows={rows} id="t-job" />
    <nav class="other" aria-labelledby="other-v">
      <h2 id="other-v">{job.nom} {t.since}…</h2>
      <ul>
        {
          others.map((v) => (
            <li>
              <a href={jobUrl(lang, jobId, v.version)}>{versionLabel(lang, v)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<style>
  .intro {
    padding: 20px 0 8px;
  }
  h1 {
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    letter-spacing: -0.03em;
    max-width: 22ch;
    margin-bottom: 14px;
  }
  .counts {
    margin: 16px 0;
    font-weight: 500;
  }
  .other {
    margin-top: 56px;
  }
  .other h2 {
    font-size: 1.3rem;
    margin-bottom: 10px;
  }
  .other ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .other a {
    color: var(--muted);
    text-underline-offset: 3px;
  }
</style>
