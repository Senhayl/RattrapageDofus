---
import Base from "../layouts/Base.astro";
import Picker from "./Picker.astro";
import SpellChanges from "./SpellChanges.astro";
import { getClassDiff, getDiff, versions, versionLabel, spellVerdict, classUrl, alternates, balanceOf } from "../lib/data";
import BalanceBar from "./BalanceBar.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { getClasses, DEFAULT_START } from "../lib/data";
import { UI, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  classId: number;
  depuis: string;
}
const { lang, classId, depuis } = Astro.props;
const t = UI[lang];
const diff = getDiff(lang, depuis);
const c = getClassDiff(lang, depuis, classId);
const now = versions.actuelle;
const since = diff.depuis;

const verdicts = c.sorts_modifies.map(spellVerdict);
const ups = verdicts.filter((v) => v === "up").length;
const nerfs = verdicts.filter((v) => v === "nerf").length;
const [m, a, r] = [c.sorts_modifies.length, c.sorts_ajoutes.length, c.sorts_retires.length];
const nothing = m + a + r === 0;
const [countStrong, countRest] = t.counts(m, a, r);

const title = t.classTitle(c.classe, since.version, now.version);
const description = t.classDescription(c.classe, since.version, now.version, m, a, r);
const others = versions.depart.filter((v) => v.version !== depuis);
const slug = getClasses(lang).find((x) => x.id === classId)!.slug;
const H1_SUB = {
  fr: (v: string) => `Changements des sorts depuis la ${v}`,
  en: (v: string) => `Spell changes since ${v}`,
  es: (v: string) => `Cambios de hechizos desde la ${v}`,
};
const site = Astro.site ?? Astro.url;
const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: lang,
  dateModified: `${now.date}-01`,
  about: { "@type": "VideoGame", name: "Dofus" },
  mainEntityOfPage: new URL(classUrl(lang, classId, depuis), site).href,
};
---

<Base
  lang={lang}
  title={title}
  description={description}
  alternates={alternates((l) => classUrl(l, classId, depuis))}
  section="classes"
  ogImage={`/og/${lang}/${slug}.png`}
  jsonLd={[ld]}
  hero="band"
>
  <section class="band" slot="hero">
    <Breadcrumbs
      lang={lang}
      items={[{ name: c.classe, href: classUrl(lang, classId, DEFAULT_START) }, { name: versionLabel(lang, since) }]}
    />
    <h1>{c.classe}<span class="sr-only"> : {H1_SUB[lang](versionLabel(lang, since))}</span></h1>
    <Picker lang={lang} classId={classId} depuis={depuis} size="compact" />
  </section>

  <div class="wrap layout">
    <div class="content">
      <section class="intro">
        <p class="summary">
          {t.summary(versionLabel(lang, since), versionLabel(lang, now))}
          <strong>{countStrong}</strong>, {countRest}
          {ups + nerfs > 0 && ` ${t.verdicts(ups, nerfs)}`}
        </p>
        {m > 0 && <BalanceBar lang={lang} balance={balanceOf(c)} />}
        {
          m > 0 && (
            <nav class="index" aria-label={t.index}>
              <ul>
                {c.sorts_modifies.map((s, i) => (
                  <li>
                    <a href={`#sort-${s.spellId}`} data-verdict={verdicts[i] ?? "neutre"}>
                      {s.nom}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </section>

      {
        !nothing && (
          <fieldset class="filters" hidden>
            <legend class="sr-only">{t.filters.legend}</legend>
            <div class="seg" role="radiogroup" aria-label={t.balance.label}>
              <label>
                <input type="radio" name="verdict" value="all" checked />
                <span>{t.verdictFilter.all}</span>
              </label>
              <label>
                <input type="radio" name="verdict" value="up" />
                <span>{t.verdictFilter.up}</span>
              </label>
              <label>
                <input type="radio" name="verdict" value="nerf" />
                <span>{t.verdictFilter.nerf}</span>
              </label>
            </div>
            <label>
              <input type="checkbox" value="carac" checked /> {t.filters.carac}
            </label>
            <label>
              <input type="checkbox" value="effets" checked /> {t.filters.effets}
            </label>
            <label>
              <input type="checkbox" value="critique" /> {t.filters.critique}
            </label>
            <label>
              <input type="checkbox" value="texte" /> {t.filters.texte}
            </label>
          </fieldset>
        )
      }

      {nothing && <p class="empty">{t.nothing(c.classe, since.version)}</p>}

      {
        a > 0 && (
          <section class="block">
            <h2>{t.newSpells}</h2>
            {c.sorts_ajoutes.map((s) => (
              <article class="new">
                <h3>{s.nom}</h3>
                <p>{s.description}</p>
              </article>
            ))}
          </section>
        )
      }

      {
        r > 0 && (
          <section class="block">
            <h2>{t.removedSpells}</h2>
            <p class="removed">{c.sorts_retires.map((s) => s.nom).join(", ")}</p>
          </section>
        )
      }

      {
        m > 0 && (
          <section class="block" id="modifies">
            <h2>{t.modifiedSpells}</h2>
            {c.sorts_modifies.map((s) => (
              <SpellChanges lang={lang} spell={s} />
            ))}
          </section>
        )
      }

      <nav class="other" aria-labelledby="other-title">
        <h2 id="other-title">{t.otherTitle}</h2>
        <ul>
          {
            others.map((v) => (
              <li>
                <a href={classUrl(lang, classId, v.version)}>{t.otherLink(c.classe, versionLabel(lang, v))}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</Base>

<script>
  // Filtres : affichés seulement si le JS tourne, sinon tout reste visible.
  const fs = document.querySelector<HTMLFieldSetElement>(".filters");
  if (fs) {
    fs.hidden = false;
    const apply = () => {
      const groups = new Set(
        [...fs.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].filter((i) => i.checked).map((i) => i.value)
      );
      const verdict = fs.querySelector<HTMLInputElement>('input[name="verdict"]:checked')?.value ?? "all";
      document.querySelectorAll<HTMLElement>(".spell .row").forEach((r) => {
        r.hidden = !groups.has(r.dataset.group ?? "");
      });
      document.querySelectorAll<HTMLElement>(".spell").forEach((s) => {
        const v = s.dataset.verdict ?? "neutre";
        const okVerdict = verdict === "all" || v === verdict || v === "mixte";
        s.hidden = !okVerdict || ![...s.querySelectorAll<HTMLElement>(".row")].some((r) => !r.hidden);
      });
      document.querySelectorAll<HTMLElement>(".index a").forEach((a) => {
        const v = a.dataset.verdict ?? "neutre";
        a.classList.toggle("dim", !(verdict === "all" || v === verdict || v === "mixte"));
      });
    };
    fs.addEventListener("change", apply);
    apply();
  }
</script>

<style>
  .band {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(48px, 10vh, 92px) var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .band :global(.crumbs) {
    padding-top: 0;
    color: rgba(255, 255, 255, 0.6);
  }
  .band :global(.crumbs a) {
    color: rgba(255, 255, 255, 0.6);
  }
  h1 {
    font-size: clamp(3.5rem, 10vw, 7rem); /* 112px */
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .layout {
    padding-top: 28px;
    padding-bottom: 32px;
  }
  .content {
    max-width: 880px;
  }
  .summary {
    margin: 0;
    color: var(--text-3);
    font-weight: 300;
    max-width: 62ch;
  }
  .summary strong {
    color: #fff;
    font-weight: 500;
  }
  .intro :global(.balance) {
    margin-top: 18px;
    max-width: 640px;
  }
  .index {
    margin-top: 22px;
  }
  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .index a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem; /* 13.5px */
    color: var(--text-2);
    text-decoration: none;
  }
  .index a::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--v);
  }
  .index a:hover {
    border-color: var(--faint);
  }
  .index a.dim {
    opacity: 0.35;
  }
  [data-verdict="up"] {
    --v: var(--up);
  }
  [data-verdict="nerf"] {
    --v: var(--nerf);
  }
  [data-verdict="mixte"] {
    --v: var(--mixte);
  }
  [data-verdict="neutre"] {
    --v: var(--neutre-dot);
  }
  .filters {
    margin: 28px 0 0;
    padding: 14px 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 2;
    font-size: 0.88rem; /* 15px */
    color: var(--text-2);
  }
  .filters label {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    cursor: pointer;
  }
  .filters input[type="checkbox"] {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
    margin: 0;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg span {
    padding: 4px 14px;
    border-radius: 999px;
  }
  .seg input:checked + span {
    background: var(--text);
    color: var(--bg);
  }
  .seg input:focus-visible + span {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
  }
  .block h2,
  .other h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.125rem); /* 34px */
    margin: 44px 0 8px;
  }
  .new {
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .new h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .new p,
  .removed {
    margin: 0;
    max-width: 68ch;
    white-space: pre-line;
    color: var(--text-3);
    font-weight: 300;
  }
  .removed {
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .empty {
    font-size: 1.15rem;
    max-width: 50ch;
    margin-top: 32px;
    font-weight: 300;
  }
  .other {
    margin-top: 32px;
  }
  .other ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .other li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .other a {
    color: var(--muted);
    text-decoration: none;
  }
  .other a:hover {
    color: #fff;
  }
</style>
