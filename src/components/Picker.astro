---
// La question du site, sous forme de phrase à compléter.
import { getClasses, versions, versionLabel, DEFAULT_START } from "../lib/data";
import { UI, ROUTES, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  classId?: number;
  depuis?: string; // version
  size?: "hero" | "compact";
}
const { lang, classId = 8, depuis = DEFAULT_START, size = "hero" } = Astro.props;
const t = UI[lang];
const r = ROUTES[lang];
---

<form
  class:list={["picker", size]}
  data-default={DEFAULT_START}
  data-base={`${r.prefix}/${r.classes}/`}
  data-since={r.since}
>
  <p class="sentence">
    <span>{t.sentenceA}</span>
    <label class="slot">
      <span class="sr-only">{t.versionLabel}</span>
      <select name="depuis">
        {
          versions.depart.map((v) => (
            <option value={v.version} selected={v.version === depuis}>
              {size === "hero" ? v.version : versionLabel(lang, v)}
            </option>
          ))
        }
      </select>
    </label>
    <span>{t.sentenceB}</span>
    <label class="slot">
      <span class="sr-only">{t.classLabel}</span>
      <select name="classe">
        {
          getClasses(lang).map((c) => (
            <option value={c.slug} selected={c.id === classId}>
              {c.nom}
            </option>
          ))
        }
      </select>
    </label>
  </p>
  <slot />
  <button type="submit">{t.cta}</button>
</form>

<script>
  // Ajuste la largeur de chaque menu au texte choisi (un <select> natif prend
  // sinon la largeur de son option la plus longue).
  const fit = (s: HTMLSelectElement) => {
    const probe = document.createElement("span");
    const cs = getComputedStyle(s);
    probe.style.cssText = `position:absolute;visibility:hidden;white-space:pre;font:${cs.font};letter-spacing:${cs.letterSpacing}`;
    probe.textContent = s.selectedOptions[0]?.text ?? "";
    document.body.append(probe);
    s.style.width = `calc(${probe.getBoundingClientRect().width}px + 2px)`;
    probe.remove();
  };
  const selects = () => document.querySelectorAll<HTMLSelectElement>(".picker select");
  selects().forEach((s) => {
    fit(s);
    s.addEventListener("change", () => fit(s));
  });
  document.fonts?.ready.then(() => selects().forEach(fit));

  document.querySelectorAll<HTMLFormElement>("form.picker").forEach((form) => {
    const { default: def, base, since } = form.dataset;
    const go = (e?: Event) => {
      e?.preventDefault();
      const data = new FormData(form);
      const v = String(data.get("depuis"));
      const c = String(data.get("classe"));
      window.location.href = v === def ? `${base}${c}/` : `${base}${c}/${since}-${v.replace(/\./g, "-")}/`;
    };
    form.addEventListener("submit", go);
    // prévient l'aperçu de l'accueil
    const notify = () => {
      const data = new FormData(form);
      document.dispatchEvent(
        new CustomEvent("picker:change", { detail: { classe: data.get("classe"), depuis: data.get("depuis") } })
      );
    };
    form.querySelectorAll("select").forEach((s) => s.addEventListener("change", notify));
    notify();
    // sur une page de classe, changer un menu suffit
    if (form.classList.contains("compact")) {
      form.querySelectorAll("select").forEach((s) => s.addEventListener("change", () => go()));
    }
  });
</script>

<style>
  .picker {
    margin: 0;
  }
  .sentence {
    margin: 0;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }
  .hero .sentence {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(2.2rem, 5.6vw, 4.375rem); /* 70px */
    line-height: 1.06;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    text-wrap: balance;
  }
  .compact .sentence {
    font-weight: 300;
    font-size: clamp(1.1rem, 2.4vw, 1.3rem); /* 21px */
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
  }
  .slot {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    cursor: pointer;
  }
  .slot select {
    field-sizing: content;
    appearance: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: none;
    color: var(--accent);
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    border-radius: 0;
    max-width: 100%;
  }
  .hero .slot select {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.18em;
    line-height: 1;
    letter-spacing: 0;
  }
  .compact .slot select {
    border-bottom: 1px solid rgba(233, 217, 176, 0.6);
  }
  .slot::after {
    content: "▼";
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 300;
    pointer-events: none;
  }
  .hero .slot::after {
    font-size: 0.3em;
    margin-left: 0.15em;
    position: relative;
    top: -0.35em;
  }
  .compact .slot::after {
    content: "▾";
    margin-left: 0.2em;
    font-size: 0.8em;
  }
  .slot:hover select {
    color: #fff;
  }
  .slot select option {
    color: var(--text);
    background: var(--surface);
    font-family: var(--font-body);
    font-style: normal;
    font-size: 1rem;
  }
  button {
    font: 500 1rem/1 var(--font-body);
    background: #fff;
    color: var(--accent-ink);
    border: 0;
    border-radius: 999px;
    padding: 16px 28px;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  button:hover {
    background: var(--accent);
  }
  .compact button {
    display: none;
  }
</style>
