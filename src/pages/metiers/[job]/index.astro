---
import JobPage from "../../../components/JobPage.astro";
import { jobsOf } from "../../../lib/content";
import { DEFAULT_START } from "../../../lib/data";

export function getStaticPaths() {
  return jobsOf("fr").map((j) => ({ params: { job: j.slug }, props: { jobId: j.id } }));
}
const { jobId } = Astro.props;
---

<JobPage lang="fr" jobId={jobId} depuis={DEFAULT_START} />
