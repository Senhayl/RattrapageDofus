# En-têtes de cache servis par Cloudflare (fichiers statiques du Worker)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/hero*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=2592000

/apercu/*
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=2592000
